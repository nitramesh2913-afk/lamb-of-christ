# Copy to .env.local and fill in. These are read ONLY by the server-side route app/api/prayer/route.ts
# (lib/prayer/llm.ts). Never prefix them with NEXT_PUBLIC_, which would expose them to the browser.

# Required for prayer writing. Without it the prayer page still works: it shows verified Scripture
# and lets people write their own prayer.
LLM_API_KEY=

# "anthropic" (default) or "openai" (any OpenAI-compatible chat completions API)
LLM_PROVIDER=anthropic

# Model id. Defaults to claude-sonnet-5-5 for anthropic; REQUIRED when LLM_PROVIDER=openai.
LLM_MODEL=

# Optional overrides. Must be https (http is allowed only for localhost).
# LLM_BASE_URL=https://api.anthropic.com
# LLM_TIMEOUT_MS=30000

# Supabase Auth + PostgreSQL account sync. Run supabase/migrations/*.sql in the project first.
# These placeholders are intentionally not real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required only for the server-side account deletion endpoint. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
